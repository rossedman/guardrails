{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/guardrails",
            "args": [
              "hook",
              "SessionStart"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/guardrails",
            "args": [
              "hook",
              "PreToolUse"
            ],
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/guardrails",
            "args": [
              "hook",
              "PostToolUse"
            ],
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/guardrails",
            "args": [
              "hook",
              "Stop"
            ],
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "test-writer|implementer",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/guardrails",
            "args": [
              "hook",
              "SubagentStop"
            ],
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/guardrails",
            "args": [
              "hook",
              "SessionEnd"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
